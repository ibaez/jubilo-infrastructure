def setup_meilisearch_data_directory():
	print("setup_meilisearch_data_directory - START")
	path = "../meili_data"
	
	if os.path.exists(path):
		shutil.rmtree(path)

	os.makedirs(path, exist_ok=True)

	print("setup_meilisearch_data_directory - END")

def prod_setup(service_name_list=None):
	print("Running production-safe setup...")

	# ------------------------------
	# Unlike dev_setup(), this never tears down containers, never
	# regenerates .env files/secrets, and never wipes migrations or the
	# database. It only applies pending migrations and provisions the
	# superuser/OAuth applications if they don't already exist -- see
	# jubilo-auth/scripts/auth_prod_setup.py.
	#
	docker_run("auth", "python -m scripts.auth_prod_setup")

